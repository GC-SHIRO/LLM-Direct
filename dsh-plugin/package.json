{
  "name": "@local/dsh-llm-direct-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Dobot X-Trainer mock robot workbench for the DSH right sidebar",
  "type": "module",
  "engines": { "dsh": "0.2.2-rc.1" },
  "exports": { ".": "./index.js", "./client": "./client.js" },
  "files": ["index.js", "bridge.js", "client.js", "cordis.patch.yml"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right"]
    }
  }
}
